{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "noEmitOnError": true,
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@hybrid-hris/db": ["../../packages/db/dist"],
      "@hybrid-hris/db/*": ["../../packages/db/dist/*"],
      "@hybrid-hris/domain": ["../../packages/domain/dist"],
      "@hybrid-hris/domain/*": ["../../packages/domain/dist/*"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/db" },
    { "path": "../../packages/domain" }
  ]
}
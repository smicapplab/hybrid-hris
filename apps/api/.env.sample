# Database
POSTGRES_USER=hris
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=hris_db

# Used by Drizzle / API
DATABASE_URL=postgresql://hris:your_password_here@localhost:5432/hris_db

# ==============================
# Auth / JWT Configuration
# ==============================

# Secret used to sign short-lived access tokens
JWT_ACCESS_SECRET=change_me_access_secret

# Secret used to sign refresh tokens (should be different from access secret)
JWT_REFRESH_SECRET=change_me_refresh_secret

# Access token lifetime (recommended: 10m–30m)
JWT_ACCESS_TTL=15m

# Refresh token lifetime (recommended: 7d–30d)
JWT_REFRESH_TTL=7d

# ==============================
# Refresh Cookie Configuration
# ==============================

# Name of the HTTP-only cookie storing refresh token
COOKIE_REFRESH_NAME=hris_refresh

# For local development, keep this false.
# Must be true in production when using HTTPS.
COOKIE_SECURE=false

# SameSite policy: "lax" works for same-site apps.
# Use "none" if frontend and API are on different domains (requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax

# Leave empty for localhost.
# In production with subdomains, use something like: .yourdomain.com
COOKIE_DOMAIN=
{
  "name": "@hybrid-hris/db",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "build": "tsc",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/pg": "^8.16.0",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.7.0"
  }
}

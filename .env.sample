# Database
POSTGRES_USER=hris
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=hris_db

# Used by Drizzle / API
DATABASE_URL=postgresql://hris:your_password_here@localhost:5432/hris_db

# ==============================
# Auth / JWT Configuration
# ==============================

# Secret used to sign short-lived access tokens
JWT_ACCESS_SECRET=change_me_access_secret

# Secret used to sign refresh tokens (should be different from access secret)
JWT_REFRESH_SECRET=change_me_refresh_secret

# Access token lifetime (recommended: 10m–30m)
JWT_ACCESS_TTL=15m

# Refresh token lifetime (recommended: 7d–30d)
JWT_REFRESH_TTL=7d

# ==============================
# Refresh Cookie Configuration
# ==============================

# Name of the HTTP-only cookie storing refresh token
COOKIE_REFRESH_NAME=hris_refresh

# For local development, keep this false.
# Must be true in production when using HTTPS.
COOKIE_SECURE=false

# SameSite policy: "lax" works for same-site apps.
# Use "none" if frontend and API are on different domains (requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax

# Leave empty for localhost.
# In production with subdomains, use something like: .yourdomain.com
COOKIE_DOMAIN=

# ==============================
# OAuth & Workspace Integration
# ==============================

# Public URL of the frontend (for redirects)
FRONTEND_URL=http://localhost:3000

# Base URL of the API (for OAuth callbacks)
API_BASE_URL=http://localhost:4000

# Google Workspace Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft 365 Credentials
MICROSOFT_CLIENT_ID=your_ms_client_id
MICROSOFT_CLIENT_SECRET=your_ms_client_secret

# Demo Flags
LOAD_TEST_DATA=true
NEXT_PUBLIC_API_URL=http://localhost:4000\n# Automation\nENABLE_INTERNAL_SCHEDULER=true # Set to false for Lambda/Serverless environments
